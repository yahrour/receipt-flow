{
  "name": "receipt-flow",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "init": "tsx --env-file .env scripts/init.ts",
    "build": "tsc",
    "start": "node --env-file .env dist/app.js",
    "dev": "tsx --env-file .env --watch src/app.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "node --experimental-vm-modules --env-file .env node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts}": [
      "npm --prefix ./ run lint:fix",
      "npm --prefix ./ run format"
    ],
    "*.{json,yml,yaml,md}": [
      "npm --prefix ./ run format"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "better-auth": "^1.5.6",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "express": "^4.22.1",
    "http-errors": "^2.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "resend": "^6.1.3",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
